<!--
  Custom Wazuh Detection Rules — Mini SOC Lab
  Place this file at /var/ossec/etc/rules/local_rules.xml on the Wazuh manager
  (or merge these <rule> blocks into your existing local_rules.xml),
  then restart the manager: sudo systemctl restart wazuh-manager

  Rule ID ranges 100000-119999 are reserved for custom/local rules — safe to use here.
-->

<group name="local,mini_soc_lab,">

  <!-- ============================================================
       Scenario 1: SSH Brute Force — tuned threshold
       ============================================================ -->
  <rule id="100010" level="10" frequency="5" timeframe="120">
    <if_matched_sid>5716</if_matched_sid>
    <same_source_ip />
    <description>Mini SOC Lab: Possible SSH brute force - 5 failed logins from same IP in 2 minutes</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,mini_soc_lab,</group>
  </rule>

  <!-- ============================================================
       Scenario 2: Port Scan Detection
       Requires connection logs (e.g., from auditd, iptables logging,
       or Suricata forwarding into Wazuh). Adjust field names to match
       your actual log source.
       ============================================================ -->
  <rule id="100020" level="10" frequency="20" timeframe="60">
    <if_matched_sid>100021</if_matched_sid>
    <same_source_ip />
    <description>Mini SOC Lab: Possible port scan - 20+ distinct connection attempts from same IP in 60 seconds</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>recon,mini_soc_lab,</group>
  </rule>

  <rule id="100021" level="3">
    <decoded_as>iptables</decoded_as>
    <field name="action">DROP</field>
    <description>Mini SOC Lab: Connection attempt logged by firewall (building block rule for 100020)</description>
    <group>mini_soc_lab,</group>
  </rule>

  <!-- ============================================================
       Scenario 3: Reverse Shell Indicators
       Requires auditd (Linux) process monitoring enabled and
       forwarded to Wazuh.
       ============================================================ -->
  <rule id="100030" level="12">
    <decoded_as>auditd</decoded_as>
    <field name="audit.command">^bash$</field>
    <field name="audit.a0">^-i$</field>
    <description>Mini SOC Lab: Interactive bash shell spawned - possible reverse shell</description>
    <mitre>
      <id>T1059</id>
    </mitre>
    <group>command_execution,mini_soc_lab,</group>
  </rule>

  <rule id="100031" level="12" frequency="1" timeframe="30">
    <if_matched_sid>100030</if_matched_sid>
    <description>Mini SOC Lab: Interactive shell followed by outbound network activity - likely reverse shell / C2</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <group>command_and_control,mini_soc_lab,</group>
  </rule>

</group>

<!--
  Notes for your write-up:
  - Rule 5716 (referenced in 100010) is Wazuh's built-in "sshd authentication failed" rule ID.
    Verify this matches your Wazuh version - check /var/ossec/ruleset/rules/0095-sshd_rules.xml
  - Rules 100020/100021 assume you're logging dropped/rejected connections via iptables or similar.
    If you don't have this, this is a great opportunity to add Suricata as a log source instead.
  - Rule 100030 assumes auditd is configured with a rule watching execve syscalls, e.g.:
      auditctl -a always,exit -F arch=b64 -S execve -k exec_log
  - Tune all frequency/timeframe values based on your own testing - document what you chose and why
    in your incident report. Hiring managers care more about your reasoning than the exact numbers.
-->
